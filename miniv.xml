<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="miniv"
          fetch="https://github.com/MINI-V-Android"
          revision="refs/heads/lineage-23.2" />

  <!-- Android Framework -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base"
           name="android_frameworks_base"
           remote="miniv" />

  <!-- qcom libvmmem -->
  <!-- qcom device trees require this repository, but lineageos did not apply this project to all devices -->
  <!-- remove later if they apply this to all devices -->
  <project path="vendor/qcom/opensource/libvmmem"
         name="LineageOS/android_vendor_qcom_opensource_libvmmem"
         revision="lineage-23.2" />

  <!-- MINI-V AI -->
  <!-- chat application -->
  <project path="packages/apps/MiniVChat"
           name="android_packages_apps_MiniVChat"
           remote="miniv" />

  <!-- framework -->
  <project path="frameworks/mini-v"
           name="android_frameworks_mini-v"
           remote="miniv" />

  <!-- demon -->
  <project path="vendor/mini-v/ai"
           name="android_vendor_mini-v_ai"
           remote="miniv" />

  <!-- llama.cpp -->
  <project path="external/llama.cpp-npu"
           name="llama.cpp-npu"
           remote="miniv"
           revision="htp-backend" />
           <!-- TODO: register to HAL -->

  <!-- Hexagon HTP ops -->
  <project path="external/htp-ops-lib"
           name="htp-ops-lib"
           remote="miniv"
           revision="main" />
           <!-- TODO: register to HAL -->

  <!-- Configs -->
  <project path="vendor/mini-v/config" name="android_vendor_mini-v_config" remote="miniv" />

  <!-- Scripts -->
  <project  path="vendor/mini-v/scripts" name="android_vendor_mini-v_scripts" remote="miniv" />

  <!-- Xiaomi 13 (fuxi) -->
  <project path="device/xiaomi/fuxi" name="android_device_xiaomi_fuxi" remote="miniv" />
  <project path="device/xiaomi/sm8550-common" name="android_device_xiaomi_sm8550-common" remote="miniv" />

  <project path="kernel/xiaomi/sm8550" name="android_kernel_xiaomi_sm8550" remote="miniv" />
  <project path="kernel/xiaomi/sm8550-devicetrees" name="android_kernel_xiaomi_sm8550-devicetrees" remote="miniv" />
  <project path="kernel/xiaomi/sm8550-modules" name="android_kernel_xiaomi_sm8550-modules" remote="miniv" />

  <project path="vendor/xiaomi/fuxi" name="proprietary_vendor_xiaomi_fuxi" remote="miniv" />
  <project path="vendor/xiaomi/sm8550-common" name="proprietary_vendor_xiaomi_sm8550-common" remote="miniv" />

  <!-- Xiaomi Redmi Note 10 Pro (sweet) -->
  <project path="device/xiaomi/sweet" name="android_device_xiaomi_sweet" remote="miniv" />
  <project path="device/xiaomi/sm6150-common" name="android_device_xiaomi_sm6150-common" remote="miniv" />

  <project path="kernel/xiaomi/sm6150" name="android_kernel_xiaomi_sm6150" remote="miniv" />

  <project path="vendor/xiaomi/sweet" name="proprietary_vendor_xiaomi_sweet" remote="miniv" />
  <project path="vendor/xiaomi/sm6150-common" name="proprietary_vendor_xiaomi_sm6150-common" remote="miniv" />

  <!-- Xiaomi Common -->
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="miniv" />
</manifest>
